{
  "name": "@raviy06/pi-agent-activity",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Read-only pi-subagents activity companion for pi-minimal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raviy06/pi-agent-activity.git"
  },
  "homepage": "https://github.com/raviy06/pi-agent-activity#readme",
  "bugs": {
    "url": "https://github.com/raviy06/pi-agent-activity/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:pkg": "npm run build && node scripts/build-package.mjs",
    "pack:pkg": "npm run build:pkg && npm pack ./dist-pkg",
    "check:release": "node scripts/check-release.mjs --name @raviy06/pi-agent-activity",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test test-dist/test/*.test.js test/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
